# =============================================================================
# 构建上下文裁剪：只保留构建镜像必需的文件
# 注意：不要排除 models/、wheelhouse/、debhouse/ —— 它们是本地物料：
#       离线模型 / Python 依赖 wheel / 系统依赖 deb 闭包
# =============================================================================

# 版本控制与 IDE
.git
.gitignore
.idea
.vscode

# 工作区元数据 / 离线打包输出
.workbuddy
dist
run.log

# compose 的本地变量覆盖（可能含内网源地址与凭据，绝不能进镜像）
.env

# Python 字节码
__pycache__
*.py[cod]

# 开发期测试客户端（运行时不需要，且内部含硬编码服务地址）
test_client.html
test_client_wss.html
